---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { pick, t, type Lang } from '../i18n/ui';
import { getEntries, profile } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entries = await getEntries('teaching');
---
<Base lang={lang} title={t(lang, 'teaching.title')} description={profile.teaching.body[lang]} glow>
  <div class="wrap">
    <header class="pb-10 pt-10 md:pt-16">
      <p class="eyebrow">The University of Queensland · {profile.teaching.course}</p>
      <h1 class="page-title mt-4">{t(lang, 'teaching.title')}</h1>
    </header>
    <div class="grid gap-5 lg:grid-cols-[1.5fr_1fr]">
      <section class="glass p-7 md:p-9">
        <h2 class="serif text-3xl leading-tight">{profile.teaching.course} · {pick(profile.teaching.title, lang)}</h2>
        <p class="mt-4 text-muted">{profile.teaching.body[lang]}</p>
        <a class="text-link mt-5 inline-block text-sm font-semibold" href={profile.teaching.link}>{t(lang, 'teaching.course')} ↗</a>
      </section>
      <section class="glass p-7 md:p-9">
        <h2 class="eyebrow">{t(lang, 'teaching.supervision')}</h2>
        <p class="mt-3 text-muted">{pick(profile.supervision.role, lang)}</p>
        <ul class="mt-4 space-y-2">
          {profile.supervision.students.map((s: any) => <li><a class="serif text-xl hover:text-teal" href={s.url}>{s.name} ↗</a></li>)}
        </ul>
      </section>
    </div>
    <h2 class="section-title mt-20">{t(lang, 'teaching.history')}</h2>
    <EntryList entries={entries} lang={lang} />
  </div>
</Base>
