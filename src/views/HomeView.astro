---
import Base from '../layouts/Base.astro';
import Headline from '../components/Headline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NewsTicker from '../components/react/NewsTicker';
import HeroSearch from '../components/react/HeroSearch';
import { formatMonth, localePath, pick, t, type Lang } from '../i18n/ui';
import { getPublications, news, profile, projects, scholar } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;

const pubs = await getPublications();
const featured = projects.filter((p) => p.featured).slice(0, 3);
const latest = news[0];
const tickerItems = news.slice(0, 12).map((item) => ({
  date: formatMonth(item.date, lang),
  title: (lang === 'zh' && item.title_zh) || item.title,
  url: item.url,
}));
const stats = [
  { value: scholar.citations.toLocaleString('en'), label: t(lang, 'stat.citations') },
  { value: String(scholar.h_index), label: t(lang, 'stat.hindex') },
  { value: String(pubs.length), label: t(lang, 'stat.papers') },
  { value: String(scholar.i10_index), label: t(lang, 'stat.i10') },
];
const examples = lang === 'zh'
  ? ['深度检索 Agent', 'LLM 重排序', '系统综述', '高效 RAG', 'Boolean query generation']
  : ['deep-search agents that read only what matters', 'reasoning rerankers trained with RL', 'how can LLMs write Boolean queries?', 'compressing context for faster RAG', 'embeddings with flexible layers and dimensions'];
import { TWIN_ENDPOINT } from '../components/react/TwinChat';
---
<Base lang={lang} glow preloadItalic>
  <div class="wrap">
    <section class="grid items-center gap-12 pb-14 pt-8 md:grid-cols-[1fr_220px] md:gap-20 md:pt-20">
      <div class="min-w-0">
        <!-- Mobile: small avatar instead of the large portrait. -->
        <div class="mb-6 flex items-center gap-4 md:hidden">
          <img src={profile.avatar} alt={profile.short_name[lang]} width="80" height="80" fetchpriority="high" class="h-20 w-20 rounded-full border border-line object-cover object-top" />
          <p class="text-[13px] leading-snug text-muted">{pick(profile.location, lang)}<br />{profile.pronouns}</p>
        </div>
        <a href={latest.url ?? localePath(lang, '/news/')} class="pill rise max-w-full">
          <span class="dot shrink-0"></span><span class="min-w-0 truncate">{t(lang, 'home.new')} · {(lang === 'zh' && latest.title_zh) || latest.title}</span>
        </a>
        <Headline text={profile.headline[lang]} class="display rise rise-2 mt-6 text-[clamp(40px,6vw,62px)]" />
        <p class="lede prose-links rise rise-3 mt-6" set:html={profile.bio[lang]} />
        <div class="rise rise-4 mt-8 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
          <a class="btn btn-solid justify-center whitespace-nowrap max-sm:!px-3" href={localePath(lang, '/research/')}><span class="sm:hidden">{t(lang, 'nav.research')}</span><span class="hidden sm:inline">{t(lang, 'home.explore')}</span> →</a>
          <a class="btn justify-center whitespace-nowrap max-sm:!px-3" href={localePath(lang, '/cv/')}>{t(lang, 'home.cv')}</a>
          <a class="btn justify-center whitespace-nowrap max-sm:!px-3" href={profile.links.scholar} rel="me noopener" target="_blank">{t(lang, 'home.scholar')} ↗</a>
          {TWIN_ENDPOINT && <button type="button" class="btn justify-center whitespace-nowrap max-sm:!px-3" data-open-twin><span aria-hidden="true">🧘</span> <span class="sm:hidden">{lang === 'zh' ? '问问分身' : 'Ask my twin'}</span><span class="hidden sm:inline">{lang === 'zh' ? '和我的数字分身聊聊' : 'Talk with my digital twin'}</span></button>}
        </div>
        <div class="rise rise-4 mt-8 max-w-[560px]">
          <HeroSearch client:idle action={localePath(lang, '/publications/')} label={t(lang, 'home.search.label')} button={t(lang, 'home.search.go')} examples={examples} lang={lang} />
        </div>
      </div>
      <figure class="rise rise-3 relative hidden w-full max-w-[220px] justify-self-end md:block">
        <div class="absolute -inset-2 rounded-[22px] bg-gradient-to-br from-[var(--glow-1)] to-[var(--glow-2)] opacity-60 blur-[14px]" aria-hidden="true"></div>
        <img src={profile.portrait_web} alt={profile.short_name[lang]} width="220" height="275" decoding="async" class="relative aspect-[4/5] w-full rounded-[16px] border border-line object-cover" />
        <figcaption class="relative mt-3 text-[13px] text-muted">{pick(profile.location, lang)} · {profile.pronouns}</figcaption>
      </figure>
    </section>

    <section class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4" aria-label={t(lang, 'home.metrics')}>
      {stats.map((stat) => (
        <div class="glass px-5 py-5 md:px-6">
          <p class="serif text-[32px] leading-tight md:text-[40px]">{stat.value}</p>
          <p class="label mt-1">{stat.label}</p>
        </div>
      ))}
    </section>

    <section class="mt-24">
      <div class="mb-7 flex items-baseline justify-between gap-4">
        <h2 class="section-title">{t(lang, 'home.selected')}</h2>
        <a class="inline-block py-2 text-sm font-semibold text-teal" href={localePath(lang, '/publications/')}>{t(lang, 'home.allpubs')} →</a>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {featured.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
    </section>

    <section class="mt-24">
      <div class="mb-7 flex items-baseline justify-between gap-4">
        <h2 class="section-title">{t(lang, 'home.news')}</h2>
        <a class="inline-block py-2 text-sm font-semibold text-teal" href={localePath(lang, '/news/')}>{t(lang, 'home.archive')} →</a>
      </div>
      <NewsTicker client:visible items={tickerItems} pauseLabel={t(lang, 'home.news.pause')} playLabel={t(lang, 'home.news.play')} />
    </section>

    <section class="mt-24 grid gap-5 md:grid-cols-2">
      <div class="glass p-7 md:p-9">
        <p class="eyebrow">{t(lang, 'home.teaching')}</p>
        <h2 class="serif mt-3 text-3xl leading-tight">{profile.teaching.course} · {pick(profile.teaching.title, lang)}</h2>
        <p class="mt-3 text-muted">{profile.teaching.body[lang]}</p>
        <a class="text-link mt-5 inline-block text-sm font-semibold" href={localePath(lang, '/teaching/')}>{t(lang, 'home.courses')} →</a>
      </div>
      <div class="glass p-7 md:p-9">
        <p class="eyebrow">{t(lang, 'research.opportunities')}</p>
        <h2 class="serif mt-3 text-3xl leading-tight">{t(lang, 'home.together')}</h2>
        <p class="mt-3 text-muted">{profile.opportunities[lang]}</p>
        <a class="text-link mt-5 inline-block text-sm font-semibold" href={`mailto:${profile.email}`}>{profile.email} →</a>
      </div>
    </section>
  </div>
</Base>
