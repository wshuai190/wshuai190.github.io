---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { localePath, localizeEntry, t, type Lang } from '../i18n/ui';

type Entry = CollectionEntry<'teaching'> | CollectionEntry<'talks'> | CollectionEntry<'awards'>;
interface Props { lang: Lang; entry: Entry; section: 'teaching' | 'talks' | 'awards' }
const { lang, entry, section } = Astro.props;
const { Content } = await render(entry);
const sectionTitle = t(lang, section === 'teaching' ? 'teaching.title' : section === 'talks' ? 'talks.title' : 'awards.title');
const data = localizeEntry(entry.data, lang);
const excerpt = lang === 'zh' ? entry.data.excerpt_zh || entry.data.excerpt : entry.data.excerpt;
const bodyZh = lang === 'zh' ? entry.data.body_zh : undefined;
const meta = [data.venue, /^(awards?|talks?)$/i.test(entry.data.type ?? '') ? undefined : data.type, data.venue?.includes(data.location ?? '\u0000') ? undefined : data.location].filter(Boolean).join(' · ');
const date = entry.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-AU', { year: 'numeric', month: 'long', timeZone: 'UTC' });
---
<Base lang={lang} title={data.title} description={excerpt || `${data.title}${meta ? ` — ${meta}` : ''}. ${sectionTitle} · ${lang === 'zh' ? '王率 Shuai Wang' : 'Shuai Wang'}.`}>
  <article class="wrap max-w-[860px]">
    <nav class="pt-8 text-sm"><a class="text-muted hover:text-ink" href={localePath(lang, `/${section}/`)}>← {sectionTitle}</a></nav>
    <header class="pt-8">
      <p class="label">{date}</p>
      <h1 class="serif mt-3 text-[clamp(30px,4.4vw,46px)] leading-[1.12]">{data.title}</h1>
      {meta && <p class="mt-3 text-muted">{meta}</p>}
    </header>
    <div class="paper-body glass mt-8 p-7 text-[17px] leading-relaxed md:p-9">{bodyZh ? <p set:html={bodyZh} /> : <Content />}</div>
  </article>
</Base>
