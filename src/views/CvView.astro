---
import Base from '../layouts/Base.astro';
import Authors from '../components/Authors.astro';
import { localePath, pick, t, type Lang } from '../i18n/ui';
import { authorsOf, getEntries, getPublications, profile, venueLabel } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;

const pubs = await getPublications();
const talks = await getEntries('talks');
const teaching = await getEntries('teaching');
const awards = await getEntries('awards');
const contact = [
  [pick(profile.location, lang), null],
  [profile.email, `mailto:${profile.email}`],
  ['Google Scholar', profile.links.scholar],
  ['GitHub', profile.links.github],
  ['ORCID', profile.links.orcid],
] as const;
---
<Base lang={lang} title={t(lang, 'cv.title')}>
  <article class="wrap max-w-[960px]">
    <header class="grid items-end gap-8 pb-10 pt-10 md:grid-cols-[1fr_180px] md:pt-16">
      <div>
        <p class="eyebrow">{t(lang, 'cv.title')}</p>
        <h1 class="page-title mt-4">{profile.name[lang]} <span class="text-muted">({profile.nickname})</span></h1>
        <p class="mt-3 text-lg">{pick(profile.role, lang)}</p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          {contact.map(([label, href]) => <li>{href ? <a class="hover:text-ink" href={href}>{label}</a> : label}</li>)}
        </ul>
        <button type="button" onclick="window.print()" class="btn no-print mt-6">{t(lang, 'cv.print')}</button>
      </div>
      <img src={profile.cv_portrait} alt="" width="180" height="240" class="hidden rounded-[18px] border border-line md:block" />
    </header>

    <section class="cv-section">
      <h2>{t(lang, 'cv.profile')}</h2>
      <p class="text-[17px]">{profile.cv_profile[lang]}</p>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'research.education')}</h2>
      <ol>
        {profile.education.map((item: any) => (
          <li><span class="cv-when">{item.year}</span><span><strong>{item[lang].title}</strong> — {item[lang].org}{item.link && <> · <a class="text-link" href={item.link}>{t(lang, 'research.thesis')}</a></>}</span></li>
        ))}
      </ol>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'research.experience')}</h2>
      <ol>
        {profile.experience.map((item: any) => (
          <li><span class="cv-when">{item.years[lang]}</span><span><strong>{item[lang].title}</strong> — {item[lang].org}<br /><span class="text-muted">{item[lang].detail}</span></span></li>
        ))}
      </ol>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'pubs.title')} <span class="text-muted">({pubs.length})</span></h2>
      <ol>
        {pubs.map((pub) => (
          <li>
            <span class="cv-when">{pub.data.date.getUTCFullYear()}</span>
            <span>
              <a class="font-semibold hover:text-teal" href={localePath(lang, pub.data.permalink)}>{pub.data.title}</a>
              <Authors authors={authorsOf(pub)} class="text-sm text-muted" />
              <span class="text-sm text-muted">{venueLabel(pub.data.venue, pub.data.date.getUTCFullYear())}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="mt-3 text-xs text-muted">{t(lang, 'pub.equal')}</p>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'research.service')}</h2>
      <ul>
        {profile.service.roles.map((role: any) => <li><span class="cv-when"></span><span><strong>{role[lang]}</strong></span></li>)}
        <li><span class="cv-when"></span><span>{t(lang, 'research.journals')}: {profile.service.journals.map((j: any) => j[lang]).join('; ')}</span></li>
        <li><span class="cv-when"></span><span>{t(lang, 'research.conferences')}: {profile.service.conferences.join('; ')}</span></li>
      </ul>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'teaching.history')}</h2>
      <ol>
        {teaching.map((e) => <li><span class="cv-when">{e.data.date.getUTCFullYear()}</span><a class="hover:text-teal" href={localePath(lang, e.data.permalink)}>{e.data.title}</a></li>)}
      </ol>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'cv.supervision')}</h2>
      <ul>
        <li><span class="cv-when"></span><span><strong>{pick(profile.supervision.role, lang)}</strong>: {profile.supervision.students.map((s: any, i: number) => <>{i > 0 && ', '}<a class="text-link" href={s.url}>{s.name}</a></>)}</span></li>
      </ul>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'talks.title')}</h2>
      <ol>{talks.map((e) => <li><span class="cv-when">{e.data.date.getUTCFullYear()}</span><span>{e.data.title}{e.data.venue && <span class="text-muted"> — {e.data.venue}</span>}</span></li>)}</ol>
    </section>

    <section class="cv-section">
      <h2>{t(lang, 'awards.title')}</h2>
      <ol>{awards.map((e) => <li><span class="cv-when">{e.data.date.getUTCFullYear()}</span><a class="hover:text-teal" href={localePath(lang, e.data.permalink)}>{e.data.title}</a></li>)}</ol>
    </section>
  </article>
</Base>

<style>
  .cv-section { border-top: 1px solid var(--line); padding: 2rem 0; break-inside: avoid-page; }
  .cv-section h2 { font: 500 12px/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal); margin-bottom: 1rem; }
  .cv-section li { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: 0.45rem 0; }
  .cv-when { font: 13px/1.6 var(--font-mono); color: var(--muted); }
  @media (max-width: 640px) { .cv-section li { grid-template-columns: 1fr; gap: 0; } }
  @media print { .cv-section { padding: 1rem 0; } .cv-section h2 { color: #000; } }
</style>
