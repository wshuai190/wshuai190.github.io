---
import Base from '../layouts/Base.astro';
import { localePath, t, type Lang } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={t(lang, 'notfound.title')} noindex glow>
  <section class="wrap py-24 text-center md:py-32">
    <img src={profile.cv_portrait} alt="" width="120" height="160" class="mx-auto mb-8 w-[120px] -rotate-3 rounded-[14px] border border-line shadow-[var(--lift)]" />
    <p class="eyebrow">404</p>
    <h1 class="page-title mt-4">{t(lang, 'notfound.title')}</h1>
    <p class="lede mx-auto mt-5">{t(lang, 'notfound.body')}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a class="btn btn-solid" href={localePath(lang, '/')}>{t(lang, 'nav.home')}</a>
      <button type="button" data-open-search class="btn">{t(lang, 'nav.search')} <span class="pointer-coarse:hidden">⌘K</span></button>
      <a class="btn" href={localePath(lang, '/publications/')}>{t(lang, 'nav.publications')}</a>
    </div>
    <div data-did-you-mean hidden class="mx-auto mt-12 max-w-xl text-left">
      <p class="eyebrow">{lang === 'zh' ? '你是不是在找' : 'Did you mean'}</p>
      <ul class="glass mt-3 px-5"></ul>
    </div>
  </section>
</Base>

<script>
  import { passageLink, search } from '../lib/search/hybrid.ts';

  // GitHub Pages serves the root (English) 404.html for every missing URL, so the smart parts run here.
  const path = location.pathname;
  const lang = document.documentElement.lang.startsWith('zh') ? 'zh' : 'en';

  async function exists(url: string) {
    try { return (await fetch(url, { method: 'HEAD' })).ok; } catch { return false; }
  }

  async function recover() {
    if (/\/404(\.html)?\/?$/.test(path)) return suggest(); // already on a 404 page: never redirect again
    // 1. Same URL with/without the trailing slash (/publication/x/ vs /research/x).
    const alternate = path.endsWith('/') ? path.replace(/\/+$/, '') : `${path}/`;
    if (alternate && alternate !== path && (await exists(alternate))) {
      location.replace(alternate + location.search + location.hash);
      return;
    }
    // 2. A missing Chinese page gets the Chinese 404.
    if (lang === 'en' && path.startsWith('/zh/')) {
      location.replace(`/zh/404?from=${encodeURIComponent(path)}`);
      return;
    }
    return suggest();
  }

  const SECTIONS = ['research', 'publications', 'teaching', 'cv', 'about', 'news', 'awards', 'talks'];

  function distance(a: string, b: string) {
    const row = Array.from({ length: b.length + 1 }, (_, j) => j);
    for (let i = 1; i <= a.length; i++) {
      let previous = row[0];
      row[0] = i;
      for (let j = 1; j <= b.length; j++) {
        const current = row[j];
        row[j] = Math.min(row[j] + 1, row[j - 1] + 1, previous + (a[i - 1] === b[j - 1] ? 0 : 1));
        previous = current;
      }
    }
    return row[b.length];
  }

  function show(links: { href: string; title: string }[]) {
    const box = document.querySelector<HTMLElement>('[data-did-you-mean]');
    const list = box?.querySelector('ul');
    if (!box || !list || !links.length) return;
    for (const { href, title } of links) {
      const item = document.createElement('li');
      item.className = 'border-b border-line py-3 last:border-b-0';
      const link = document.createElement('a');
      link.href = href;
      link.className = 'serif text-lg hover:text-[var(--teal)]';
      link.textContent = title;
      item.append(link);
      list.append(item);
    }
    box.hidden = false;
  }

  async function suggest() {
    const missing = new URLSearchParams(location.search).get('from') ?? path;
    // 3. A mistyped section (/teching/, /cv.html, /zh/publicatons/) → that section.
    // An exact section with a bad slug after it (/research/typo) falls through to the search below.
    const [first, ...rest] = missing.replace(/^\/(zh\/)?/, '').replace(/\.html?$/, '').toLowerCase().split('/').filter(Boolean);
    const section = first && first !== 'publication' && SECTIONS.find((name) => {
      const d = distance(first, name);
      return d <= (name.length > 4 ? 2 : 1) && (d > 0 || rest.length === 0);
    });
    if (section) {
      const label = document.querySelector<HTMLAnchorElement>(`header nav a[href$="/${section}/"]`)?.textContent ?? section;
      show([{ href: `${lang === 'zh' ? '/zh' : ''}/${section}/`, title: label }]);
      return;
    }
    // 4. Otherwise turn the URL into a query and suggest the closest pages (keyword search, no model download).
    const query = decodeURIComponent(missing).replace(/^\/(zh\/)?/, '').replace(/\.html?$/, '').replace(/[-_/.]+/g, ' ').replace(/\b\d{4} \d{2} \d{2}\b/, '').trim();
    if (!query || query === '404') return;
    const { results } = await search(query, { lang, semantic: false, limit: 4, types: ['paper', 'project', 'teaching', 'talk', 'award'] });
    show(results.map(({ doc }) => ({ href: passageLink(doc, lang), title: doc.title })));
  }
  recover();
</script>
