---
import { alternatePath, localePath, t, type Lang } from '../i18n/ui';
import { profile } from '../lib/data';

interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;

const items = [
  { key: 'nav.home', href: '/' },
  { key: 'nav.research', href: '/research/' },
  { key: 'nav.publications', href: '/publications/' },
  { key: 'nav.teaching', href: '/teaching/' },
  { key: 'nav.cv', href: '/cv/' },
] as const;

const bare = lang === 'zh' ? path.replace(/^\/zh(?=\/|$)/, '') || '/' : path;
function isActive(href: string) {
  if (href === '/') return bare === '/';
  if (href === '/publications/') return bare.startsWith('/publications') || bare.startsWith('/publication/');
  return bare.startsWith(href.replace(/\/$/, ''));
}
---
<header class="site-header wrap relative z-20">
  <div class="flex items-center justify-between gap-4 py-5">
    <a href={localePath(lang, '/')} class="serif text-[22px] font-medium whitespace-nowrap">
      {profile.short_name.en}<span class="ml-2 font-sans text-sm text-muted">王率</span>
    </a>

    <nav class="glass hidden min-[860px]:flex items-center gap-1 rounded-full p-[5px] text-sm" aria-label="Primary">
      {items.map((item) => (
        <a
          href={localePath(lang, item.href)}
          class:list={['rounded-full px-4 py-1.5 transition-colors', isActive(item.href) ? 'bg-ink text-bg font-semibold' : 'text-muted hover:text-ink']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >{t(lang, item.key)}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 text-xs mono text-muted">
      <button type="button" data-open-search class="hidden sm:inline-flex items-center gap-2 rounded-full border border-line px-3 py-1.5 hover:text-ink transition-colors" aria-label={t(lang, 'nav.search')}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <kbd class="font-[inherit]">⌘K</kbd>
      </button>
      <button type="button" data-theme-toggle class="grid h-8 w-8 place-items-center rounded-full border border-line hover:text-ink transition-colors" aria-label={t(lang, 'theme.toggle')}>
        <svg class="dark:hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden dark:block" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={alternatePath(lang, path)} hreflang={lang === 'zh' ? 'en' : 'zh'} class="rounded-full border border-line px-3 py-1.5 font-sans hover:text-ink transition-colors">{t(lang, 'nav.switch')}</a>

      <details class="relative min-[860px]:hidden">
        <summary class="list-none cursor-pointer rounded-full border border-line px-3 py-1.5 font-sans hover:text-ink" aria-label={t(lang, 'nav.menu')}>☰</summary>
        <nav class="glass absolute right-0 mt-2 flex w-52 flex-col p-2 font-sans text-sm text-ink shadow-xl" aria-label="Mobile">
          {items.map((item) => (
            <a href={localePath(lang, item.href)} class:list={['rounded-xl px-3 py-2', isActive(item.href) && 'bg-ink text-bg font-semibold']}>{t(lang, item.key)}</a>
          ))}
          <button type="button" data-open-search class="rounded-xl px-3 py-2 text-left text-muted">{t(lang, 'nav.search')}</button>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    });
  });
</script>
