---
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const url = `https://shuaiwang.io/keenable-discovery-lab/?lang=${lang}#home`;
---
<a
  href={url}
  class="glass lift group mt-12 flex w-full max-w-lg items-center gap-3 p-3 sm:gap-4"
  data-search-skip
>
  <span class="figure-frame aspect-[16/10] w-20 shrink-0 p-1 sm:w-32" aria-hidden="true">
    <img
      src="/images/projects/discovery-lab.webp"
      width="800"
      height="500"
      alt=""
      loading="lazy"
      decoding="async"
      class="transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </span>
  <span>
    <span class="serif block text-xl leading-tight">{lang === 'zh' ? '搜索轨迹' : 'Search Trails'}</span>
    <span class="mt-1 block text-sm text-muted">
      {lang === 'zh' ? '双语搜索与互动实验' : 'Search & experiments'}
    </span>
  </span>
</a>
