---
import { existsSync } from 'node:fs';
import { localePath, pick, t, TOPIC_LABELS, type Lang } from '../i18n/ui';
import { starsOf, type Project } from '../lib/data';
import LinkPills from './LinkPills.astro';

interface Props {
  project: Project;
  lang: Lang;
  size?: 'md' | 'lg';
}
const { project, lang, size = 'md' } = Astro.props;
const href = localePath(lang, `/research/${project.slug}/`);
const summary = lang === 'zh' ? project.summary_zh : project.summary;
const stars = starsOf(project.links.code);
// 640px variants (public/images/research/*-640.webp) for the card grid; the full image is for detail pages.
function small(src: string) {
  const variant = src.replace(/\.webp$/, '-640.webp');
  return variant !== src && existsSync(`public${variant}`) ? `${variant} 640w, ${src} 1200w` : undefined;
}
---
<article class="glass lift group relative flex flex-col p-3.5" data-search-skip>
  <a href={href} class="figure-frame aspect-[16/10] p-3" tabindex="-1" aria-hidden="true">
    <img src={project.image} srcset={small(project.image)} sizes="(min-width: 768px) 400px, calc(100vw - 64px)" alt="" loading="lazy" decoding="async" class="transition-transform duration-500 group-hover:scale-[1.03]" />
  </a>
  <div class="flex flex-1 flex-col px-1.5 pb-1.5">
    <p class="tag mt-4">{pick(TOPIC_LABELS[project.topic], lang)} · {project.year}</p>
    <h3 class:list={['serif mt-1 leading-tight', size === 'lg' ? 'text-[26px]' : 'text-[22px]']}>
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{project.name}</a>
    </h3>
    <p class="mt-2 text-sm text-muted">{summary}</p>
    <div class="relative z-[1] mt-auto flex items-end justify-between gap-2 pt-4">
      <div class="flex flex-wrap gap-1.5"><LinkPills links={project.links} lang={lang} /></div>
      {stars !== undefined && <span class="mono shrink-0 pb-1 text-xs text-muted" title={t(lang, 'project.githubStars')} aria-label={`${t(lang, 'project.githubStars')}: ${stars}`}>★ {stars}</span>}
    </div>
  </div>
</article>
