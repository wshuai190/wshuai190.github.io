---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/react/SearchPalette';
import { alternatePath, t, type Lang } from '../i18n/ui';
import { profile } from '../lib/data';
import { jsonLd, personSchema, profilePageSchema, websiteSchema } from '../lib/seo';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  glow?: boolean;
  /** 'article' for papers (adds published time); 'profile' for the home page. */
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  /** Extra schema.org nodes for this page (see src/lib/seo.ts). */
  schema?: object[];
  noindex?: boolean;
}

const { lang, title, description, image, glow = false, type = 'website', published, schema = [], noindex = false } = Astro.props;
const siteName = lang === 'zh' ? '王率 Shuai Wang' : 'Dr. Shuai Wang';
const path = Astro.url.pathname.replace(/\.html$/, '');
const isHome = path === '/' || path === '/zh/';
const fullTitle = title ? `${title} · ${siteName}` : profile.seo.title[lang];
const desc = (description ?? profile.seo.description[lang]).replace(/\s+/g, ' ').trim().slice(0, 300);
const canonical = new URL(path, Astro.site).href;
const enHref = new URL(lang === 'en' ? path : alternatePath(lang, path), Astro.site).href;
const zhHref = new URL(lang === 'zh' ? path : alternatePath(lang, path), Astro.site).href;
const ogImage = new URL(image ?? '/images/og.png', Astro.site).href;
const graph = [...(isHome ? [profilePageSchema(lang), personSchema(), websiteSchema(lang)] : []), ...schema];
const verification = profile.seo.verification ?? {};
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="author" content="Shuai Wang" />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    <link rel="alternate" type="application/rss+xml" title="Shuai Wang" href="/feed.xml" />
    <link rel="icon" type="image/png" href="/images/site-logo.png" />
    <link rel="apple-touch-icon" href="/images/site-logo.png" />
    <link rel="preload" href="/fonts/Manrope-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080a0e" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content="https://shuaiwang.io/" />}
    <meta property="og:site_name" content="Shuai Wang" />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_AU'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:alt" content={title ?? siteName} />
    <meta name="twitter:site" content="@dylan_wangs" />
    <meta name="twitter:creator" content="@dylan_wangs" />
    <slot name="head" />
    {graph.length > 0 && <script type="application/ld+json" set:html={jsonLd(...graph)} />}
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body>
    {glow && <div class="glow-bg" aria-hidden="true" />}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-solid">Skip to content</a>
    <Header lang={lang} path={path} />
    <main id="main" class="relative z-[1]">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchPalette client:idle lang={lang} />
  </body>
</html>
